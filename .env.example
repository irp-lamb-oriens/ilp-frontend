# Next.js public API base URL (points at the Deno server).
# LOCAL: http://localhost:8000
# PRODUCTION: the deployed backend URL.
NEXT_PUBLIC_API_URL=https://ilp-backend-nlbz.onrender.com

# P6 ── Content-Security-Policy (src/middleware.ts). Needed at build AND at
# runtime (Netlify edge middleware).
# enforce | report-only. Default: enforce in production builds, report-only in
# `next dev`. Deploy once with report-only, watch error_log kind "csp", then
# remove it (enforce).
CSP_MODE=report-only
# Optional extra connect-src origins, space or comma separated.
CSP_EXTRA_CONNECT=
